{
  "name": "kaiten-card-mcp",
  "version": "0.1.0",
  "description": "Read Kaiten cards, comments and attachments from any MCP client",
  "type": "module",
  "bin": {
    "kaiten-card-mcp": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/server.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.en.md",
    "docs",
    "npm-shrinkwrap.json",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.15.0"
  },
  "license": "MIT",
  "author": "Vitaly Solovyov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VitalySolovyovDev/kaiten-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/VitalySolovyovDev/kaiten-mcp/issues"
  },
  "homepage": "https://github.com/VitalySolovyovDev/kaiten-mcp#readme",
  "keywords": [
    "mcp",
    "kaiten",
    "model-context-protocol",
    "attachments"
  ],
  "scripts": {
