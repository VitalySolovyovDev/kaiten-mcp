{
  "name": "kaiten-mcp-tools",
  "version": "0.1.1",
  "description": "Read-only MCP server for Kaiten cards, spaces, boards, discussions, catalogs and time tracking, with original attachments for agent analysis",
  "type": "module",
  "bin": {
    "kaiten-mcp-tools": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/server.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.en.md",
    "docs",
    "npm-shrinkwrap.json",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.15.0"
  },
  "license": "MIT",
  "author": "Vitaly Solovyov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VitalySolovyovDev/kaiten-mcp-tools.git"
  },
  "bugs": {
    "url": "https://github.com/VitalySolovyovDev/kaiten-mcp-tools/issues"
  },
  "homepage": "https://github.com/VitalySolovyovDev/kaiten-mcp-tools#readme",
  "keywords": [
    "mcp",
    "kaiten",
    "model-context-protocol",
    "attachments"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "check": "npm run build && npm test",
    "start": "node dist/cli.js",
    "prepack": "npm run build",
    "pack:release": "node scripts/pack-release.mjs",
    "check:lf": "node scripts/check-lf.mjs",
    "test:package": "node scripts/test-package.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "typescript": "^5.9.2",
    "vitest": "^5.0.4"
  }
}
